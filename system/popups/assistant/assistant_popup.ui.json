{
  "name": "assistant_popup",
  "root": {
    "type": "container",
    "id": "root",
    "geometry": { "x": 0, "y": 0, "w": "100%", "h": "100%" },
    "padding": [24, 24, 24, 24],
    "opa": 255,
    "layout": {
      "type": "vbox",
      "spacing": 16,
      "main_align": "end",
      "cross_align": "center"
    },
    "children": [
      {
        "type": "container",
        "id": "frame",
        "size": { "w": "100%", "h": 0 },
        "layout_item": { "grow": 1 },
        "padding": [16, 16, 16, 16],
        "radius": 24,
        "border_width": 2,
        "opa": 255,
        "visible": false,
        "clip_corner": true,
        "layout": {
          "type": "vbox",
          "spacing": 0,
          "main_align": "start",
          "cross_align": "start"
        },
        "children": [
          {
            "type": "container",
            "id": "scroll",
            "size": { "w": "100%", "h": "100%" },
            "padding": [0, 0, 0, 0],
            "border_width": 0,
            "opa": 0,
            "layout": {
              "type": "vbox",
              "spacing": 10,
              "main_align": "start",
              "cross_align": "start"
            },
            "scroll": {
              "enabled": true,
              "dir": "ver",
              "scrollbar": "auto"
            },
            "children": [
              {
                "type": "label",
                "id": "question_label",
                "size": { "w": "100%", "h": "content" },
                "text": " ",
                "align": "left",
                "overflow": "wrap"
              }
            ]
          }
        ]
      },
      {
        "type": "container",
        "id": "footer",
        "size": { "w": "100%", "h": "content" },
        "opa": 0,
        "layout": {
          "type": "hbox",
          "spacing": 14,
          "main_align": "start",
          "cross_align": "center"
        },
        "children": [
          {
            "type": "container",
            "id": "speech_slot",
            "size": { "w": 0, "h": "content" },
            "layout_item": { "grow": 1 },
            "opa": 0,
            "visible": false,
            "layout": {
              "type": "vbox",
              "main_align": "start",
              "cross_align": "start"
            },
            "children": [
              {
                "type": "label",
                "id": "answer_label",
                "size": { "w": "content", "h": "content" },
                "radius": 24,
                "border_width": 2,
                "pad_hor": 16,
                "pad_ver": 10,
                "font": { "weight": 24, "wordSpace": 0, "rowSpace": 2 },
                "max_lines": 2,
                "text": " ",
                "align": "left",
                "overflow": "wrap"
              }
            ]
          }
        ]
      }
    ]
  }
}
